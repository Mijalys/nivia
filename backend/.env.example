# production exige APP_SECRET, DATABASE_URL, PUBLIC_URL y ADMIN_PASSWORD, y no carga datos demo
NODE_ENV=development
# Puerto de la API
PORT=3000
# Secreto para firmar tokens y URLs de archivos (32+ caracteres). Obligatorio en producción.
# Genera uno con: openssl rand -hex 32
APP_SECRET=
# PostgreSQL real. Si se deja vacío, se usa PGlite en PGLITE_DIR.
DATABASE_URL=
PGLITE_DIR=./.data/pglite
# Base pública de la API (para armar URLs firmadas)
PUBLIC_URL=http://localhost:3000
# Carpeta que hace de almacenamiento de objetos en desarrollo
STORAGE_DIR=./storage
# App del aprendiz: la API la sirve en /app/ desde APP_DIR. Los correos enlazan a APP_URL
APP_DIR=../app
APP_URL=http://localhost:3000/app/
# Piloto con una sola empresa: slug de la empresa cuando no hay cabecera X-Tenant
DEFAULT_TENANT=
# Orígenes externos con CORS, separados por coma. Vacío: solo mismo origen
CORS_ORIGINS=
# Google: ID de cliente OAuth (Aplicación web). Ver ../arquitectura/google-cloud.md
GOOGLE_CLIENT_ID=
# Brevo: clave de API y remitente verificado. Sin clave, los correos van al log
BREVO_API_KEY=
EMAIL_FROM=no-responder@nivia.pe
ACCESS_TTL_S=900
REFRESH_TTL_DAYS=30
# Cargar datos de demostración si la base está vacía (por defecto: sí en desarrollo, no en producción)
SEED_ON_EMPTY=
# Contraseña del administrador de plataforma (usuario admin), 12+ caracteres en producción.
# En desarrollo, sin definir, vale la de demostración
ADMIN_PASSWORD=
