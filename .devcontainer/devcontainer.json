{
  "name": "Nivia",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:22",
  "hostRequirements": { "cpus": 2 },
  "forwardPorts": [3000],
  "portsAttributes": { "3000": { "label": "Nivia (app y API)", "onAutoForward": "notify" } },
  "postCreateCommand": "cd backend && npm ci",
  "postStartCommand": "bash .devcontainer/start.sh"
}
