{
  "name": "nivia-backend",
  "version": "0.1.0",
  "private": true,
  "description": "API de Nivia: marca blanca, aprendiz, evaluación, certificados y avance sin señal.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "dev": "tsc -p tsconfig.build.json && node dist/main.js",
    "db:migrate": "tsc -p tsconfig.build.json && node dist/db/cli.js migrate",
    "db:seed": "tsc -p tsconfig.build.json && node dist/db/cli.js seed",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest --runInBand"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.14",
    "@nestjs/common": "11.2.8",
    "@nestjs/core": "11.2.8",
    "@nestjs/platform-express": "11.2.8",
    "@node-rs/argon2": "2.2.2",
    "pdfkit": "0.17.2",
    "pg": "8.16.3",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.1.13"
  },
  "devDependencies": {
    "@nestjs/testing": "11.2.8",
    "@types/express": "5.0.6",
    "@types/jest": "30.0.0",
    "@types/node": "22.20.5",
    "@types/pdfkit": "0.17.7",
    "@types/pg": "8.15.6",
    "@types/supertest": "6.0.3",
    "jest": "30.1.3",
    "supertest": "7.1.4",
    "ts-jest": "29.4.15",
    "typescript": "5.9.3"
  }
}
