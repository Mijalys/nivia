# Puerto de la API
PORT=3000
# Secreto para firmar tokens y URLs de archivos. Obligatorio fuera de desarrollo.
APP_SECRET=
# PostgreSQL real. Si se deja vacío, se usa PGlite en PGLITE_DIR.
DATABASE_URL=
PGLITE_DIR=./.data/pglite
# Base pública de la API (para armar URLs firmadas)
PUBLIC_URL=http://localhost:3000
# Carpeta que hace de almacenamiento de objetos en desarrollo
STORAGE_DIR=./storage
# App del aprendiz: los correos enlazan aquí
APP_URL=http://localhost:4178/prototipo/
# Google: ID de cliente OAuth (Aplicación web). Ver ../arquitectura/google-cloud.md
GOOGLE_CLIENT_ID=
# Brevo: clave de API y remitente verificado. Sin clave, los correos van al log
BREVO_API_KEY=
EMAIL_FROM=no-responder@nivia.pe
ACCESS_TTL_S=900
REFRESH_TTL_DAYS=30
# Cargar datos de demostración si la base está vacía
SEED_ON_EMPTY=true
# Contraseña del administrador de plataforma (usuario admin). Sin definir: Demo2026
ADMIN_PASSWORD=
